import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

class OpportunityDetailsScreen extends StatefulWidget {
  final Map<String, dynamic> opportunity;

  const OpportunityDetailsScreen({
    super.key,
    required this.opportunity,
  });

  @override
  State<OpportunityDetailsScreen> createState() =>
      _OpportunityDetailsScreenState();
}

class _OpportunityDetailsScreenState
    extends State<OpportunityDetailsScreen> {
  final SupabaseClient _supabase = Supabase.instance.client;

  bool _isSaved = false;
  bool _isLoadingSaveStatus = true;
  bool _isSaving = false;

  Map<String, dynamic> get opportunity => widget.opportunity;

  @override
  void initState() {
    super.initState();
    _loadSaveStatus();
  }

  Future<void> _loadSaveStatus() async {
    try {
      final user = _supabase.auth.currentUser;

      if (user == null) {
        if (mounted) {
          setState(() {
            _isSaved = false;
            _isLoadingSaveStatus = false;
          });
        }
        return;
      }

      final opportunityId = opportunity['id'];

      if (opportunityId == null) {
        if (mounted) {
          setState(() {
            _isSaved = false;
            _isLoadingSaveStatus = false;
          });
        }
        return;
      }

      final result = await _supabase
          .from('opportunity_saves')
          .select('id')
          .eq('user_id', user.id)
          .eq('opportunity_id', opportunityId)
          .maybeSingle();

      if (!mounted) return;

      setState(() {
        _isSaved = result != null;
        _isLoadingSaveStatus = false;
      });
    } catch (_) {
      if (!mounted) return;

      setState(() {
        _isSaved = false;
        _isLoadingSaveStatus = false;
      });
    }
  }

  Future<void> _toggleSave() async {
    if (_isSaving) return;

    final user = _supabase.auth.currentUser;

    if (user == null) {
      _showMessage(
        'Please sign in to save opportunities.',
        isError: true,
      );
      return;
    }

    final opportunityId = opportunity['id'];

    if (opportunityId == null) {
      _showMessage(
        'This opportunity could not be saved.',
        isError: true,
      );
      return;
    }

    setState(() {
      _isSaving = true;
    });

    try {
      if (_isSaved) {
        await _supabase
            .from('opportunity_saves')
            .delete()
            .eq('user_id', user.id)
            .eq('opportunity_id', opportunityId);

        if (!mounted) return;

        setState(() {
          _isSaved = false;
        });

        _showMessage(
          'Opportunity removed from saved opportunities.',
        );
      } else {
        await _supabase.from('opportunity_saves').insert({
          'user_id': user.id,
          'opportunity_id': opportunityId,
        });

        if (!mounted) return;

        setState(() {
          _isSaved = true;
        });

        _showMessage(
          'Opportunity saved successfully.',
        );
      }
    } catch (_) {
      _showMessage(
        'Something went wrong. Please try again.',
        isError: true,
      );
    } finally {
      if (mounted) {
        setState(() {
          _isSaving = false;
        });
      }
    }
  }

  void _showMessage(
    String message, {
    bool isError = false,
  }) {
    if (!mounted) return;

    ScaffoldMessenger.of(context).hideCurrentSnackBar();

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(message),
        backgroundColor:
            isError ? const Color(0xFFE9322A) : const Color(0xFF1F6B4F),
        behavior: SnackBarBehavior.floating,
      ),
    );
  }

  String _textValue(
    String key, {
    String fallback = '',
  }) {
    final value = opportunity[key];

    if (value == null) return fallback;

    final text = value.toString().trim();

    if (text.isEmpty) return fallback;

    return text;
  }

  DateTime? _dateValue(String key) {
    final value = opportunity[key];

    if (value == null) return null;

    try {
      return DateTime.parse(value.toString()).toLocal();
    } catch (_) {
      return null;
    }
  }

  String _formatDate(DateTime? date) {
    if (date == null) return '';

    const months = [
      'January',
      'February',
      'March',
      'April',
      'May',
      'June',
      'July',
      'August',
      'September',
      'October',
      'November',
      'December',
    ];

    return '${date.day} ${months[date.month - 1]} ${date.year}';
  }

  String _formatDateTime(DateTime? date) {
    if (date == null) return '';

    const months = [
      'Jan',
      'Feb',
      'Mar',
      'Apr',
      'May',
      'Jun',
      'Jul',
      'Aug',
      'Sep',
      'Oct',
      'Nov',
      'Dec',
    ];

    final hour =
        date.hour.toString().padLeft(2, '0');

    final minute =
        date.minute.toString().padLeft(2, '0');

    return '${date.day} ${months[date.month - 1]} ${date.year} '
        '$hour:$minute';
  }

  String _opportunityType() {
    final possibleKeys = [
      'type',
      'category',
      'opportunity_category',
      'opportunity_type',
    ];

    for (final key in possibleKeys) {
      final value = _textValue(key);

      if (value.isNotEmpty) {
        return value;
      }
    }

    return 'Opportunity';
  }

  IconData _typeIcon() {
    final type = _opportunityType().toLowerCase();

    if (type.contains('tender')) {
      return Icons.account_balance_outlined;
    }

    if (type.contains('employment') ||
        type.contains('job') ||
        type.contains('career')) {
      return Icons.work_outline;
    }

    if (type.contains('learnership') ||
        type.contains('internship') ||
        type.contains('education') ||
        type.contains('training')) {
      return Icons.school_outlined;
    }

    if (type.contains('fund') ||
        type.contains('grant') ||
        type.contains('finance')) {
      return Icons.account_balance_wallet_outlined;
    }

    return Icons.lightbulb_outline;
  }

  Color _typeColor() {
    final type = _opportunityType().toLowerCase();

    if (type.contains('tender')) {
      return const Color(0xFF1F4F7C);
    }

    if (type.contains('employment') ||
        type.contains('job') ||
        type.contains('career')) {
      return const Color(0xFF3D7A5E);
    }

    if (type.contains('learnership') ||
        type.contains('internship') ||
        type.contains('education') ||
        type.contains('training')) {
      return const Color(0xFF6C4BA3);
    }

    if (type.contains('fund') ||
        type.contains('grant') ||
        type.contains('finance')) {
      return const Color(0xFFB7791F);
    }

    return const Color(0xFF1F6B4F);
  }

  Future<void> _copyApplicationLink() async {
    final link = _findApplicationLink();

    if (link.isEmpty) {
      _showMessage(
        'No application link is available.',
        isError: true,
      );
      return;
    }

    await Clipboard.setData(
      ClipboardData(text: link),
    );

    _showMessage(
      'Application link copied.',
    );
  }

  String _findApplicationLink() {
    final possibleKeys = [
      'application_url',
      'application_link',
      'link',
      'url',
      'website',
    ];

    for (final key in possibleKeys) {
      final value = _textValue(key);

      if (value.isNotEmpty) {
        return value;
      }
    }

    return '';
  }

  @override
  Widget build(BuildContext context) {
    final title = _textValue(
      'title',
      fallback: 'Opportunity',
    );

    final description = _textValue(
      'description',
      fallback:
          'No additional information has been provided for this opportunity.',
    );

    final organisation = _textValue(
      'organisation',
      fallback: 'Organisation not specified',
    );

    final location = _textValue(
      'location',
      fallback: 'Location not specified',
    );

    final opportunityType =
        _opportunityType();

    final applicationLink =
        _findApplicationLink();

    final closingDate =
        _dateValue('closing_date');

    final publishedDate =
        _dateValue('published_at') ??
            _dateValue('created_at');

    return Scaffold(
      backgroundColor:
          const Color(0xFFF8F7F4),

      appBar: AppBar(
        backgroundColor:
            const Color(0xFFF8F7F4),

        elevation: 0,

        surfaceTintColor:
            Colors.transparent,

        leading: IconButton(
          icon: const Icon(
            Icons.arrow_back_ios_new,
            color: Color(0xFF1F232B),
          ),

          onPressed: () {
            Navigator.of(context).pop();
          },
        ),

        title: const Text(
          'Opportunity',
          style: TextStyle(
            color: Color(0xFF1F232B),
            fontSize: 21,
            fontWeight: FontWeight.w800,
          ),
        ),

        centerTitle: true,

        actions: [
          if (_isLoadingSaveStatus)
            const Padding(
              padding: EdgeInsets.only(
                right: 16,
              ),

              child: SizedBox(
                width: 24,
                height: 24,

                child:
                    CircularProgressIndicator(
                  strokeWidth: 2,
                ),
              ),
            )
          else
            IconButton(
              onPressed:
                  _isSaving ? null : _toggleSave,

              icon: Icon(
                _isSaved
                    ? Icons.bookmark
                    : Icons.bookmark_border,

                color: _isSaved
                    ? _typeColor()
                    : const Color(
                        0xFF1F232B,
                      ),

                size: 28,
              ),
            ),
        ],
      ),

      body: SafeArea(
        top: false,

        child: SingleChildScrollView(
          padding:
              const EdgeInsets.fromLTRB(
            20,
            12,
            20,
            32,
          ),

          child: Column(
            crossAxisAlignment:
                CrossAxisAlignment.start,

            children: [

              // OPPORTUNITY TYPE

              Container(
                padding:
                    const EdgeInsets.symmetric(
                  horizontal: 14,
                  vertical: 8,
                ),

                decoration: BoxDecoration(
                  color:
                      _typeColor().withOpacity(
                    0.12,
                  ),

                  borderRadius:
                      BorderRadius.circular(20),
                ),

                child: Row(
                  mainAxisSize:
                      MainAxisSize.min,

                  children: [

                    Icon(
                      _typeIcon(),
                      size: 18,
                      color: _typeColor(),
                    ),

                    const SizedBox(
                      width: 8,
                    ),

                    Text(
                      opportunityType,
                      style: TextStyle(
                        color: _typeColor(),
                        fontWeight:
                            FontWeight.w700,
                        fontSize: 14,
                      ),
                    ),
                  ],
                ),
              ),

              const SizedBox(
                height: 18,
              ),

              // TITLE

              Text(
                title,
                style: const TextStyle(
                  fontSize: 30,
                  height: 1.15,
                  fontWeight:
                      FontWeight.w900,
                  color: Color(
                    0xFF1F232B,
                  ),
                ),
              ),

              const SizedBox(
                height: 22,
              ),

              // ORGANISATION CARD

              Container(
                width: double.infinity,

                padding:
                    const EdgeInsets.all(18),

                decoration: BoxDecoration(
                  color: Colors.white,

                  borderRadius:
                      BorderRadius.circular(20),

                  boxShadow: const [
                    BoxShadow(
                      color:
                          Color(0x0D000000),
                      blurRadius: 18,
                      offset: Offset(
                        0,
                        6,
                      ),
                    ),
                  ],
                ),

                child: Column(
                  children: [

                    _InfoRow(
                      icon:
                          Icons.business_outlined,

                      title:
                          'Organisation',

                      value:
                          organisation,
                    ),

                    const SizedBox(
                      height: 18,
                    ),

                    _InfoRow(
                      icon: Icons
                          .location_on_outlined,

                      title: 'Location',

                      value: location,
                    ),

                    if (publishedDate !=
                        null) ...[
                      const SizedBox(
                        height: 18,
                      ),

                      _InfoRow(
                        icon:
                            Icons
                                .calendar_today_outlined,

                        title:
                            'Published',

                        value:
                            _formatDateTime(
                          publishedDate,
                        ),
                      ),
                    ],

                    if (closingDate !=
                        null) ...[
                      const SizedBox(
                        height: 18,
                      ),

                      _InfoRow(
                        icon:
                            Icons
                                .event_busy_outlined,

                        title:
                            'Closing date',

                        value:
                            _formatDate(
                          closingDate,
                        ),
                      ),
                    ],
                  ],
                ),
              ),

              const SizedBox(
                height: 26,
              ),

              // DESCRIPTION

              const Text(
                'About this opportunity',
                style: TextStyle(
                  fontSize: 21,
                  fontWeight:
                      FontWeight.w800,
                  color: Color(
                    0xFF1F232B,
                  ),
                ),
              ),

              const SizedBox(
                height: 12,
              ),

              Text(
                description,
                style: const TextStyle(
                  fontSize: 16,
                  height: 1.6,
                  color: Color(
                    0xFF4B5563,
                  ),
                ),
              ),

              const SizedBox(
                height: 30,
              ),

              // APPLICATION LINK

              if (applicationLink
                  .isNotEmpty) ...[

                const Text(
                  'How to apply',
                  style: TextStyle(
                    fontSize: 21,
                    fontWeight:
                        FontWeight.w800,
                    color: Color(
                      0xFF1F232B,
                    ),
                  ),
                ),

                const SizedBox(
                  height: 12,
                ),

                Container(
                  width: double.infinity,

                  padding:
                      const EdgeInsets.all(
                    16,
                  ),

                  decoration: BoxDecoration(
                    color: Colors.white,

                    borderRadius:
                        BorderRadius.circular(
                      18,
                    ),

                    border: Border.all(
                      color: const Color(
                        0xFFE5E7EB,
                      ),
                    ),
                  ),

                  child: Column(
                    crossAxisAlignment:
                        CrossAxisAlignment
                            .start,

                    children: [

                      const Row(
                        children: [

                          Icon(
                            Icons
                                .link_outlined,
                            color: Color(
                              0xFF1F6B4F,
                            ),
                          ),

                          SizedBox(
                            width: 8,
                          ),

                          Text(
                            'Application link',
                            style: TextStyle(
                              fontWeight:
                                  FontWeight
                                      .w700,
                              fontSize: 15,
                            ),
                          ),
                        ],
                      ),

                      const SizedBox(
                        height: 12,
                      ),

                      SelectableText(
                        applicationLink,
                        style:
                            const TextStyle(
                          color: Color(
                            0xFF1F6B4F,
                          ),
                          fontSize: 14,
                          height: 1.4,
                        ),
                      ),

                      const SizedBox(
                        height: 14,
                      ),

                      OutlinedButton.icon(
                        onPressed:
                            _copyApplicationLink,

                        icon: const Icon(
                          Icons.copy_outlined,
                        ),

                        label: const Text(
                          'Copy application link',
                        ),
                      ),
                    ],
                  ),
                ),
              ],

              const SizedBox(
                height: 32,
              ),

              // SAVE BUTTON

              SizedBox(
                width: double.infinity,
                height: 56,

                child: ElevatedButton.icon(
                  onPressed:
                      _isSaving ||
                              _isLoadingSaveStatus
                          ? null
                          : _toggleSave,

                  icon: _isSaving
                      ? const SizedBox(
                          width: 20,
                          height: 20,

                          child:
                              CircularProgressIndicator(
                            color:
                                Colors.white,
                            strokeWidth: 2,
                          ),
                        )
                      : Icon(
                          _isSaved
                              ? Icons.bookmark
                              : Icons
                                  .bookmark_border,
                        ),

                  label: Text(
                    _isSaved
                        ? 'Saved Opportunity'
                        : 'Save Opportunity',
                  ),

                  style:
                      ElevatedButton.styleFrom(
                    backgroundColor:
                        _isSaved
                            ? const Color(
                                0xFF1F6B4F,
                              )
                            : const Color(
                                0xFF1F232B,
                              ),

                    foregroundColor:
                        Colors.white,

                    elevation: 0,

                    shape:
                        RoundedRectangleBorder(
                      borderRadius:
                          BorderRadius.circular(
                        16,
                      ),
                    ),

                    textStyle:
                        const TextStyle(
                      fontSize: 16,
                      fontWeight:
                          FontWeight.w800,
                    ),
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _InfoRow extends StatelessWidget {
  final IconData icon;
  final String title;
  final String value;

  const _InfoRow({
    required this.icon,
    required this.title,
    required this.value,
  });

  @override
  Widget build(BuildContext context) {
    return Row(
      crossAxisAlignment:
          CrossAxisAlignment.start,

      children: [

        Container(
          width: 42,
          height: 42,

          decoration: BoxDecoration(
            color:
                const Color(0xFF1F6B4F)
                    .withOpacity(0.10),

            borderRadius:
                BorderRadius.circular(12),
          ),

          child: Icon(
            icon,
            color:
                const Color(0xFF1F6B4F),
            size: 21,
          ),
        ),

        const SizedBox(
          width: 14,
        ),

        Expanded(
          child: Column(
            crossAxisAlignment:
                CrossAxisAlignment.start,

            children: [

              Text(
                title,
                style: const TextStyle(
                  color:
                      Color(0xFF6B7280),
                  fontSize: 13,
                  fontWeight:
                      FontWeight.w600,
                ),
              ),

              const SizedBox(
                height: 4,
              ),

              Text(
                value,
                style: const TextStyle(
                  color:
                      Color(0xFF1F232B),
                  fontSize: 16,
                  height: 1.3,
                  fontWeight:
                      FontWeight.w700,
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }
}
